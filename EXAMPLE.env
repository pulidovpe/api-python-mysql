## Example environment file for local development / docker runs
## Copy this to .env and adapt values before running the container

# Flask environment (development|production|testing)
FLASK_ENV=development

# App settings
APP_PORT=3000
APP_SECRET=your-secret-key-here

# Database settings
# For local Docker on Linux, use host.docker.internal if supported, otherwise
# point DB_HOST to the actual host/IP where MySQL is reachable (e.g. your host IP or an RDS endpoint).
DB_HOST=host.docker.internal
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=api_python_mysql
DB_USERNAME=root
DB_PASSWORD=root

# Notes:
# - If you run the DB as a container on the same Docker network, use the container name as DB_HOST.
# - If the container cannot reach the DB at startup, the app (in development mode) will try to create tables
#   and may fail. For quick local testing you can set FLASK_ENV=testing to use sqlite in-memory.

# If you want to run the image without a database (for smoke-testing the container
# in ECS/Fargate), set SKIP_DB_CHECKS=true. The `/health` endpoint will return 200
# with `database: skipped` and other endpoints will not perform the pre-request DB check.
# Example:
# SKIP_DB_CHECKS=true